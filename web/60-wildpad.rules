# Wildpad: let the browser (WebHID, WebUSB) and the tools reach the pad on Linux.
# Install once:
#   sudo cp 60-wildpad.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
# then unplug the pad and plug it back in.

# The pad (keyboard, setup interface, update mode)
SUBSYSTEM=="usb", ATTRS{idVendor}=="1189", ATTRS{idProduct}=="8890", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="1189", ATTRS{idProduct}=="8890", MODE="0660", TAG+="uaccess"

# The CH552's built-in bootloader (first install, key 1 at plug-in)
SUBSYSTEM=="usb", ATTRS{idVendor}=="4348", ATTRS{idProduct}=="55e0", MODE="0660", TAG+="uaccess"
